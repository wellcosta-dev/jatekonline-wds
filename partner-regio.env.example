# Másold `.env.partner` néven a projekt gyökerébe (git nem követi), vagy exportáld a változókat.
PARTNER_REGIO_EMAIL=
PARTNER_REGIO_PASSWORD=
# Opcionális:
# PARTNER_NYIREGYHAZA_STORE_ID=27
# PARTNER_IN_STOCK_CAP=99
# PRICE_BATCH_SIZE=40
# FETCH_CONCURRENCY=3
# FETCH_DELAY_MS=90
# PARTNER_PROGRESS_EVERY=10
# PARTNER_PROGRESS_LINES=1
# Készlet script a nyilvános boltról (ugyanaz a /termek-… path, mint a partner linken):
# PARTNER_STOCK_HTML_ORIGIN=https://www.regiojatek.hu
# Ha a partner SOAP timeout miatt nem megy az ár: npm run partner:sync -- --stock-only
